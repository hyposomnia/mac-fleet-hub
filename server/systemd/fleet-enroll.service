[Unit]
Description=mac-fleet-hub unified multiuser server
After=network-online.target headscale.service
Wants=headscale.service

[Service]
ExecStart=/usr/local/bin/fleet-enroll
EnvironmentFile=/etc/fleet-enroll/env
Restart=on-failure
RestartSec=3
User=fleet-enroll
Group=fleet-enroll
UMask=0077
StateDirectory=fleet-enroll
StateDirectoryMode=0700
ReadWritePaths=/var/lib/fleet-enroll /etc/fleet-enroll/encryption.key
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
