{
  "id": "/",
  "name": "mac fleet hub",
  "short_name": "fleet",
  "description": "远程操作你的 Mac 集群的 Claude / Codex 会话与文件",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#FAFAFA",
  "theme_color": "#FAFAFA",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png?v=192", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png?v=192", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png?v=192", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg?v=192", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "会话",
      "short_name": "会话",
      "description": "查看所有设备上的未归档会话",
      "url": "/?mode=sessions",
      "icons": [{ "src": "icons/icon-192.png?v=192", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "文件",
      "short_name": "文件",
      "description": "浏览指定 Mac 上的文件",
      "url": "/?mode=files",
      "icons": [{ "src": "icons/icon-192.png?v=192", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
