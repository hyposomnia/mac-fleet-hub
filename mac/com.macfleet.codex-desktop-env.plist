    <string>com.macfleet.codex-desktop-env</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProgramArguments</key>
    <array>
        <string>__CODEX_DESKTOP_ENV_HELPER__</string>
        <string>__CODEX_DESKTOP_ENV_MODE__</string>
