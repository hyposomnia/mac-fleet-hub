<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macfleet.codex-app-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__MANAGED_CODEX_BIN__</string>
        <string>-c</string>
        <string>features.code_mode_host=true</string>
        <string>app-server</string>
        <string>--listen</string>
        <string>__CODEX_APPSERVER_LISTEN__</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CODEX_HOME</key>
        <string>__CODEX_HOME__</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>LC_ALL</key>
        <string>en_US.UTF-8</string>
        <key>PATH</key>
        <string>__BREW_PREFIX__/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- 只在异常退出时重启：避免配置性错误演变成无限崩溃循环（风险点 R4）。 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__FLEET_LOG_DIR__/codex-app-server-isolated.log</string>
    <key>StandardErrorPath</key>
    <string>__FLEET_LOG_DIR__/codex-app-server-isolated.err</string>
</dict>
</plist>
