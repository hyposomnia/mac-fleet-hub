<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macfleet.codex-app-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__CODEX_KEEPER_NODE__</string>
        <string>__CODEX_KEEPER_SCRIPT__</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CODEX_HOME</key>
        <string>__CODEX_HOME__</string>
        <key>FLEET_CODEX_BIN</key>
        <string>__CODEX_BIN__</string>
        <key>FLEET_CODEX_APPSERVER_LISTEN</key>
        <string>__CODEX_APPSERVER_LISTEN__</string>
        <key>FLEET_CODEX_APPSERVER_PROXY_SOCK</key>
        <string>__CODEX_APPSERVER_SOCK__</string>
        <key>FLEET_CODEX_DESKTOP_APP_PATH</key>
        <string>/Applications/ChatGPT.app</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>LC_ALL</key>
        <string>en_US.UTF-8</string>
        <key>PATH</key>
        <string>__BREW_PREFIX__/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>
    <key>StandardOutPath</key>
    <string>/tmp/macfleet-codex-app-server.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/macfleet-codex-app-server.err</string>
</dict>
</plist>
