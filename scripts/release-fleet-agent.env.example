# 复制到签名构建机 ~/.config/mac-fleet-hub/release.env，填写真实值；不要提交真实配置。
FLEET_RELEASE_BUILDER_IP=100.x.y.z
FLEET_RELEASE_WEB_BASE=https://fleet.example.com:20443
FLEET_RELEASE_GATEWAY_SSH=user@gateway.example.com
FLEET_RELEASE_GATEWAY_PORT=22
FLEET_RELEASE_MAC_TARGETS="user@100.x.y.2 user@100.x.y.3"

FLEET_CANDIDATE_BRANCH=codex/multi-user-server
FLEET_CANDIDATE_WEB_BASE=https://acceptance.example.com:7443
FLEET_CANDIDATE_GATEWAY_SSH=user@acceptance-server
FLEET_CANDIDATE_GATEWAY_PORT=22
FLEET_CANDIDATE_ROOT=/opt/macfleet-saas-uat
FLEET_CANDIDATE_CA_FILE=/path/to/acceptance-public-ca.pem

FLEET_SETTINGS_VERSION=1.0.0
FLEET_SETTINGS_BUILD=1
# 原生候选公证上传：0 为标准 S3（默认）；标准通道超时时可显式设 1 使用 Apple 官方加速。
FLEET_NOTARY_S3_ACCELERATION=0
FLEET_CANDIDATE_NGINX_CONFIG=/etc/macfleet-saas-uat-web/nginx.conf
FLEET_CMAKE=/path/to/cmake
FLEET_SPARKLE_ACCOUNT=mac-fleet-hub
FLEET_CODESIGN_IDENTITY=REPLACE_WITH_DEVELOPER_ID_SHA1
